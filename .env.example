PORT=3000

# Redis (BullMQ) connection
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis auth. This local-dev default matches docker-compose.yml; override it
# (with a strong secret) in every real environment. Set it empty
# (REDIS_PASSWORD=) to disable auth for a bring-your-own Redis that needs none.
REDIS_PASSWORD=localdev_redis_pw
# Optional: cap Redis memory (with noeviction, writes are rejected past this).
REDIS_MAXMEMORY=256mb

# PostgreSQL connection string. REQUIRED — no default; the app refuses to boot
# and migrate/studio refuse to run without it (a silent default could target
# the wrong database). Local dev: `cp .env.example .env` and this value matches
# docker-compose. Read by the Prisma CLI (via prisma.config.ts) and by the
# runtime pg driver adapter (via typed config).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflows
# Max pg connections per process. With N workers, N x this must stay under
# Postgres max_connections (default 100); front with PgBouncer at real scale.
DATABASE_POOL_MAX=10
# Time (ms) to wait for a free connection before failing (pg default is 0 =
# wait forever, which we deliberately override so a saturated pool fails fast).
DATABASE_CONNECTION_TIMEOUT_MS=30000

# PostgreSQL container credentials (used by docker-compose).
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflows
