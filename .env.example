PORT=3000

# Redis (BullMQ) connection
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis auth. This local-dev default matches docker-compose.yml; override it
# (with a strong secret) in every real environment. Set it empty
# (REDIS_PASSWORD=) to disable auth for a bring-your-own Redis that needs none.
REDIS_PASSWORD=localdev_redis_pw
# Optional: cap Redis memory (with noeviction, writes are rejected past this).
REDIS_MAXMEMORY=256mb

# PostgreSQL connection string (consumed by Prisma from task 03 onward)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflows

# PostgreSQL container credentials (used by docker-compose).
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflows
